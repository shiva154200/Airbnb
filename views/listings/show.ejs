<% layout("/layouts/boilerplate") %>

    <body>
        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-md-8">


                    <div class="card shadow-lg">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing-image">

                        <div class="card-body">
                            <p class="text-muted mb-1">
                                <b> Owned By <%=listing.owner.username%></b>
                            </p>

                            <h3 class="card-title">
                                <%= listing.title %>
                            </h3>
                            <p class="text-muted mb-1">
                                <%= listing.location %>, <%= listing.country %>
                            </p>

                            <h4 class="text-success">
                                ₹ <%= listing.price.toLocaleString("en-IN") %>
                            </h4>

                            <p class="card-text mt-3">
                                <i>
                                    <%= listing.description %>
                                </i>
                            </p>

                            <div class="d-flex gap-2 mt-3">

                                <% if(userinfo&&(userinfo._id.equals(listing.owner._id))) {%>
                                <a href="/listings/<%= listing._id %>/edit" class="btn btn-success">Edit</a>

                                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                                    <button class="btn btn-danger">Delete</button>
                                </form>

                                <% } %>

                            </div>
                        </div>
                    </div>
                    <% if(userinfo) {%>

                    <div class="card mt-4 shadow-sm">
                        <div class="card-body">
                            <h4>Add Your Review</h4>

                            <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation"
                                novalidate>

                                <label class="form-label mt-2">Rating</label>
                                <input type="range" min="1" max="5" value="3" class="form-range" name="review[rating]"
                                    required>

                                <label class="form-label mt-3">Comment</label>
                                <textarea class="form-control" rows="4" name="review[comment]" required></textarea>

                                <div class="invalid-feedback">
                                    Please enter a comment.
                                </div>

                                <button class="btn btn-dark mt-3">Submit</button>
                            </form>
                        </div>
                    </div>
                     <% } %>
                    <div class="card mt-4 shadow-sm">
                        <div class="card-body">
                            <h4>All Reviews</h4>

                            <% if (listing.reviews.length===0) { %>
                                <p class="text-muted">No reviews yet.</p>
                                <% } %>

                                    <% for (let review of listing.reviews) { %>
                                        <div class="border rounded p-3 mb-3">

                                            <div class="d-flex justify-content-between align-items-center">
                                                <strong><%= review.author.username %></strong>

                                                <div class="d-flex gap-2">
                                                    <% if(userinfo && userinfo._id.equals(review.author._id)) { %>
                                                        <a href="/listings/<%= listing._id %>/reviews/<%= review._id %>/edit" class="btn btn-sm btn-success">Edit</a>
                                                    <% } %>

                                                    <% if(userinfo && userinfo._id.equals(review.author._id)) { %>
                                                        <form
                                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                                            method="POST">
                                                            <button class="btn btn-sm btn-danger">Delete</button>
                                                        </form>
                                                    <% } %>
                                                </div>
                                            </div>

                                            <div class="text-warning mt-1">
                                                <%= "★" .repeat(review.rating) %>
                                            </div>

                                            <p class="mb-0 mt-2">
                                                <%= review.comment %>
                                            </p>
                                        </div>
                                        <% } %>
                        </div>
                    </div>


                </div>
            </div>
        </div>

    </body>
    <script src="/js/script.js"></script>